# Copy to apps/web/.env.local and apps/api/.env as needed.

# API (web → FastAPI)
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Postgres (Layer A)
DATABASE_URL=postgresql+asyncpg://cos:cos@localhost:5432/cos

# Neo4j (Layer B)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cos-neo4j-dev

# Object storage (Layer C) — MinIO locally
S3_ENDPOINT_URL=http://127.0.0.1:9000
S3_ACCESS_KEY=minio
S3_SECRET_KEY=minio-secret-change-me
S3_BUCKET_ORIGINALS=cos-originals

# OpenAI — use task-appropriate models (override per environment)
OPENAI_API_KEY=
OPENAI_MODEL_REASONING=gpt-4o
OPENAI_MODEL_STANDARD=gpt-4o-mini
OPENAI_MODEL_FAST=gpt-4o-mini
OPENAI_MODEL_TRANSCRIBE=gpt-4o-transcribe
OPENAI_MODEL_TRANSCRIBE_DIARIZE=gpt-4o-transcribe-diarize

# GitHub Projects sync (V1)
GITHUB_TOKEN=
GITHUB_PROJECT_NUMBER=

# Telegram capture (n8n / worker)
TELEGRAM_BOT_TOKEN=
