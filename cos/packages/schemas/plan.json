{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cos.local/schemas/plan.json",
  "title": "Plan",
  "type": "object",
  "required": ["objective", "input_assumptions", "task_tree", "success_criteria"],
  "properties": {
    "objective": { "type": "string" },
    "why_now": { "type": "string" },
    "input_assumptions": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "comparable_existing_systems": {
      "type": "array",
      "items": { "type": "string" }
    },
    "first_practical_milestone": { "type": "string" },
    "task_tree": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": { "type": "string" },
          "children": { "type": "array" }
        }
      }
    },
    "risks": {
      "type": "array",
      "items": { "type": "string" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string" }
    },
    "recommended_model_tool_stack": { "type": "string" },
    "success_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "kill_criteria": {
      "type": "array",
      "items": { "type": "string" }
    },
    "next_action_within_24h": { "type": "string" }
  },
  "additionalProperties": true
}
