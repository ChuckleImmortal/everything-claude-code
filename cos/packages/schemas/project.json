{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://cos.local/schemas/project.json",
  "title": "Project",
  "type": "object",
  "required": ["id", "title", "objective", "status"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "title": { "type": "string" },
    "objective": { "type": "string" },
    "status": { "type": "string" },
    "strategic_fit": { "type": "number", "minimum": 1, "maximum": 5 },
    "expected_value": { "type": "number", "minimum": 1, "maximum": 5 },
    "success_probability": { "type": "number", "minimum": 0.05, "maximum": 0.95 },
    "plan": { "type": "object", "description": "Structured plan; see plan.json schema" },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": true
}
